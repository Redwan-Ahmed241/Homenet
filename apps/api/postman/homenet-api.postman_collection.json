{
  "info": {
    "_postman_id": "homenet-api-full-check",
    "name": "Homenet API - Full Endpoint Tests",
    "description": "Automated smoke test for every Homenet API endpoint on https://homenet-api.vercel.app\n\nCovers public, user (s@g.com) and admin (a@g.com) routes. Image-upload endpoints (POST /v1/users/avatar, POST /v1/properties/:id/media, DELETE /v1/properties/media/:mediaId) are intentionally skipped.\n\nRun order matters: 01 Setup -> 02 Roles -> 03 Areas -> 04 Properties -> 05 Users. Tokens are captured automatically from the login/register responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://homenet-api.vercel.app" },
    { "key": "userEmail", "value": "s@g.com" },
    { "key": "userPassword", "value": "asdfghjk" },
    { "key": "adminEmail", "value": "a@g.com" },
    { "key": "adminPassword", "value": "asdfghjk" },
    { "key": "userToken", "value": "" },
    { "key": "userRefreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "registeredUserId", "value": "" },
    { "key": "registeredUserToken", "value": "" },
    { "key": "registeredRefreshToken", "value": "" },
    { "key": "seedAreaId", "value": "" },
    { "key": "seedPropertyId", "value": "" },
    { "key": "tempAreaId", "value": "" },
    { "key": "propertyId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "  pm.collectionVariables.set('baseUrl', 'https://homenet-api.vercel.app');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "01 - Setup & Auth (Public)",
      "item": [
        {
          "name": "POST /v1/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success=true', () => pm.expect(j.success).to.eql(true));",
                  "pm.collectionVariables.set('registeredUserId', j.data.user.id);",
                  "pm.collectionVariables.set('registeredUserToken', j.data.access_token);",
                  "pm.collectionVariables.set('registeredRefreshToken', j.data.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Tester\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"TestPass123\"\n}",
              "options": { "raw": { "language": "json" } }
