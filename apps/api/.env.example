# Database Connections (Neon / Supabase / Postgres)
# NOTE: Do NOT wrap values in quotes in Docker .env files (Docker treats quotes literally)
# Pooled connection string (port 6543 on Supabase / pooled endpoint on Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct / Unpooled connection string (port 5432) for Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require

# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Auth
JWT_SECRET=generate-a-strong-random-32-byte-hex-or-base64-secret
JWT_ACCESS_EXPIRY=15m

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Media Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGES_PER_PROPERTY=20
MAX_VIDEOS_PER_PROPERTY=3

# Logging
DISABLE_FILE_LOGS=false

# Background Task
BACKGROUND_VERIFICATION_DELAY_MS=3000

# Automatic listing verification: "off" or "mock"
VERIFICATION_MODE=off
