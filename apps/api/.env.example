DATABASE_URL="postgresql://postgres:<admin-password>@homenet-postgres-db:5432/homenet?schema=public"
JWT_SECRET="homenet-dev-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"

THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGES_PER_PROPERTY=20
MAX_VIDEOS_PER_PROPERTY=3

# Background Task
BACKGROUND_VERIFICATION_DELAY_MS=3000

# Automatic listing verification. Leave unset (or "off") in production.
# "mock" runs MockVerificationService, which invents a pass/fail verdict from the
# listing's ID — and owners are now notified of that verdict. Development and
# staging only, until a real verification provider exists.
VERIFICATION_MODE=off
