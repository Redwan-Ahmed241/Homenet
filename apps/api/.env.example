DATABASE_URL="postgresql://postgres:<admin-password>@homenet-postgres-db:5432/homenet?schema=public"
JWT_SECRET="homenet-dev-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"

THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGES_PER_PROPERTY=20
MAX_VIDEOS_PER_PROPERTY=3

# Background Task
BACKGROUND_VERIFICATION_DELAY_MS=3000

# LLM (Groq) key pool
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical everywhere that reads llm_api_keys (local, Vercel). Losing it means re-seeding keys.
LLM_MASTER_ENCRYPTION_KEY=
LLM_SEARCH_MODEL="llama-3.1-8b-instant"
LLM_LISTING_MODEL="llama-3.3-70b-versatile"
LLM_SEARCH_TIMEOUT_MS=8000
LLM_LISTING_TIMEOUT_MS=20000
